        <mxCell id="cTAOk4yeP9FnPeryfewb-306" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:25.7px;font-weight: bold;&quot;&gt;message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt; &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;{&#xa;  &quot;name&quot;: &quot;Test Door&quot;,&#xa;  &quot;state_topic&quot;: &quot;inception/binary_sensor/{inpiut-id}&quot;,&#xa;    &quot;availability_topic&quot;: &quot;inception/available&quot;,&#xa;&quot;device_class&quot;: &quot;xxxx&quot;,&#xa;&quot;payload_off&quot;: &quot;Off&quot;,&#xa;&quot;payload_on&quot;: &quot;On&quot;&#xa;}&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;font-weight: bold;&quot;&gt;Where:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;-name = name from API response &#xa;- state_topic = &amp;lt;mqtt.topic_prefix&amp;gt;/binary_sensor/{inpiut-id}&#xa;- availability_topic = from mqtt.availability_topic in config&#xa;- device_class is calculated as:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;font-style: italic;&quot;&gt;if &#39;name&#39; contains (case insensitive):&#xa;motion -&amp;gt; motion&#xa;garage -&amp;gt; garage_door&#xa;door -&amp;gt; door&#xa;rex -&amp;gt; door&#xa;opening -&amp;gt; opening&#xa;power -&amp;gt; power&#xa;smoke -&amp;gt; smoke&#xa;vibration -&amp;gt; vibration&#xa;window -&amp;gt; window&#xa;cold -&amp;gt; cold&#xa;heat -&amp;gt; heat&#xa;light -&amp;gt; light&#xa;moisture -&amp;gt; moisture&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&#xa;else, fallback to  &#39;None&#39;&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;font-weight: bold;&quot;&gt;USE:&#xa;&lt;/span&gt;&#39;qos&#39; &amp; &#39;retain&#39; properties from config -&amp;gt; mqtt&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=erkKP6AQvV~w;" vertex="1" parent="1">
          <mxGeometry x="310" y="2997" width="363" height="363" as="geometry" />
        </mxCell>
