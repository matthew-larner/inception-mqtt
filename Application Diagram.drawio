        <mxCell id="cTAOk4yeP9FnPeryfewb-360" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;POST /monitor-updates&#xa;Payload:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;[&#xa;&#x9;{&#xa;&#x9;&#x9;&quot;ID&quot;: &quot;LiveReviewEvents&quot;,&#xa;&#x9;&#x9;&quot;RequestType&quot;: &quot;LiveReviewEvents&quot;,&#xa;&#x9;&#x9;&quot;InputData&quot;: {&#xa;&#x9;&#x9;&#x9;&quot;referenceId&quot;: null,&#xa;&#x9;&#x9;&#x9;&quot;referenceTime&quot;: null&#xa;&#x9;&#x9;}&#xa;&#x9;}&#xa;]&#xa;&#xa;Note: &lt;/span&gt;&lt;a href=&quot;http://InputData.referenceId&quot;&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;InputData.referenceId&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot;font-size:10px;&quot;&gt; and &lt;/span&gt;&lt;a href=&quot;http://InputData.referenceTime&quot;&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;InputData.referenceTime&lt;/span&gt;&lt;/a&gt; are calculated from the last response. By default, both of these values should be null.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#ffbbb1;strokeWidth=0;lucidId=dcsrvABcL2_B;" vertex="1" parent="1">
          <mxGeometry x="-1106" y="6606" width="236" height="236" as="geometry" />
        </mxCell>
