        <mxCell id="cTAOk4yeP9FnPeryfewb-358" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;Do a foreach loop on the Result array. For each item, publish to MQTT - details below.&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;Topic:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;&quot;state_topic&quot; = {mqtt.topic_prefix}/event&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;e.g. &quot;inception/event&quot;&lt;/span&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;Message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;{&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;            &quot;Description&quot;: &quot;Terminal Login Failed because PIN was Unknown&quot;,&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;            &quot;MessageCategory&quot;: 13002,&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&quot;What&quot;: &quot;&quot;,&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;            &quot;Where&quot;: &quot;Elite X Terminal 1&quot;&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;        }&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;font-weight: bold;&quot;&gt;Where:&lt;/span&gt;&#xa;&quot;Description, MessageCategory, What, Where&quot; are all from the response payload.&#xa;&#xa;Use retain=false when publishing the MQTT message&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#ffbbb1;strokeWidth=0;lucidId=dcsrVxaCyaM4;" vertex="1" parent="1">
          <mxGeometry x="301" y="6555" width="382" height="382" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-359" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:16.6px;&quot;&gt;&lt;span style=&quot;font-size:16.6px;&quot;&gt;Use:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:16.6px;font-style: italic;&quot;&gt;&#39;InputData.referenceId&#39; = &#39;Result.ID&#39;&#xa;&#39;InputData.referenceTime&#39; = &#39;Result.&lt;/span&gt;&lt;span style=&quot;font-size:16.7px;color:#333333;font-style: italic;&quot;&gt;WhenTicks&lt;/span&gt;&lt;span style=&quot;font-size:16.6px;font-style: italic;&quot;&gt;&#39;&#xa;&lt;/span&gt;for the new long polling request.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#ffbbb1;strokeWidth=0;lucidId=dcsrHQXH7yK8;" vertex="1" parent="1">
