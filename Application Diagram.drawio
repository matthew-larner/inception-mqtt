        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-258" value="Setup home assistant discovery - this tells the smarthome system to create objects for all areas/doors/inputs/outputs" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;align=left;spacing=3.8;verticalAlign=middle;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=3W.JEmmS-wQp;" vertex="1" parent="1">
