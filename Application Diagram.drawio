        <mxCell id="cTAOk4yeP9FnPeryfewb-287" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:25.7px;font-weight: bold;&quot;&gt;message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt; &#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;{&#xa;  &quot;name&quot;: &quot;Indoor Screamer&quot;,&#xa;  &quot;state_topic&quot;: &quot;inception/switch/{output-id}&quot;,&#xa;  &quot;command_topic&quot;: &quot;inception/switch/{output-id}/set&quot;,&#xa;  &quot;availability_topic&quot;: &quot;inception/available&quot;,&#xa;  &quot;optimistic&quot;: false,&#xa;  &quot;payload_off&quot;: &quot;Off&quot;,&#xa;  &quot;payload_on&quot;: &quot;On&quot;,&#xa;  &quot;icon&quot;: &quot;mdi:bullhorn-outline&quot;&#xa;}&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;font-weight: bold;&quot;&gt;Where:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;-name = name from API response&#xa;- state_topic = &amp;lt;mqtt.topic_prefix&amp;gt;/binary_sensor/{output-id}&#xa;- command_topic = &amp;lt;mqtt.topic_prefix&amp;gt;/switch/{output-id}/set&#xa;- availability_topic = from mqtt.availability_topic in config&#xa;- &#39;icon&#39; is calculated as:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;font-style: italic;&quot;&gt;if &#39;name&#39; contains (case insensitive):&#xa;screamer -&amp;gt; mdi:bullhorn-outline&#xa;siren -&amp;gt; mdi:bullhorn-outline&#xa;door -&amp;gt; mdi:door-closed-lock&#xa;garage -&amp;gt; mdi:garage&#xa;gate -&amp;gt; mdi:gate&#xa;ELSE fallback to &#39;mdi:help-circle&#39;&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:9px;font-weight: bold;&quot;&gt;USE:&#xa;&lt;/span&gt;&#39;qos&#39; &amp; &#39;retain&#39; properties from config -&amp;gt; mqtt&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=y.uK9jf0vULt;" vertex="1" parent="1">
