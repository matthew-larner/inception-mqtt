        <mxCell id="cTAOk4yeP9FnPeryfewb-341" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;POST /monitor-updates&#xa;Payload:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;[&#xa;    {&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;ID&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;AreaStateRequest&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;RequestType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;MonitorEntityStates&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;InputData&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: {&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;stateType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;AreaState&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;timeSinceUpdate&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;0&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&#xa;        }&#xa;    },&#xa;    {&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;ID&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;InputStateRequest&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;RequestType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;MonitorEntityStates&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;InputData&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: {&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;stateType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;InputState&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;timeSinceUpdate&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;0&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&#xa;        }&#xa;    },&#xa;    {&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;ID&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;OutputStateRequest&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;RequestType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;MonitorEntityStates&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;InputData&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: {&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;stateType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;OutputState&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;timeSinceUpdate&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;0&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&#xa;        }&#xa;    },&#xa;    {&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;ID&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;DoorStateRequest&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;RequestType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;MonitorEntityStates&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;        &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;InputData&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: {&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;stateType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;DoorState&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;,&#xa;            &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#a31515;&quot;&gt;&quot;timeSinceUpdate&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#0451a5;&quot;&gt;&quot;0&quot;&lt;/span&gt;&lt;span style=&quot;font-size:10px;color:#000000;&quot;&gt;&#xa;        }&#xa;    }&#xa;]&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=qlGK2S19su-w;" vertex="1" parent="1">
          <mxGeometry x="-1275" y="3990" width="434" height="434" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-342" value="As soon as the connection is made, publish a &#39;online&#39; message to the mqtt.availability_topic topic. If this service crashes, the &#39;offline&#39; message will be published automatically." style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=16.6;fontStyle=2;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=sR.J.97nLPtn;" vertex="1" parent="1">
          <mxGeometry x="-570" y="135" width="240" height="240" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-343" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;Do a foreach loop on the stateData array. For each item, publish to MQTT - details below.&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;&#xa;&#xa;Topic:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;&#xa;&quot;state_topic&quot; as calculated before e.g. &quot;inception/binary_sensor/{id}&quot;&lt;/span&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;Message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;the message should be calculated by converting result.stateData.PublicState from the response to binary and pad with zeros to get to 12 digits e.g. 0000 0000 0001.&#xa;Refering to the far left digit as the first digit and the far right as the 12th digit:&#xa;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;color:#a31515;&quot;&gt;if the 12th digit=1 then &#39;On&#39;&#xa;if the 11th digit=1 then &#39;On&#39;&#xa;if the 10th digit=1 then &#39;Off&#39;&#xa;if the 9th digit=1 then &#39;On&#39;&#xa;if the 8th digit=1 then &#39;On&#39;&#xa;if the 6th digit=1 then &#39;Off&#39;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;else ignore it and don&#39;t update MQTT&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#ffeca9;strokeWidth=0;lucidId=R.YLrvEA0QNd;" vertex="1" parent="1">
          <mxGeometry x="255" y="4545" width="390" height="390" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-344" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;Do a foreach loop on the stateData array. For each item, publish to MQTT - details below.&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;&#xa;&#xa;Topic:&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;&#xa;&quot;state_topic&quot; as calculated before e.g. &quot;inception/alarm_control_panel/{id}&quot;&lt;/span&gt;&lt;span style=&quot;font-size:14px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;font-weight: bold;&quot;&gt;Message:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:15.7px;&quot;&gt;the message should be calculated by converting result.stateData.PublicState from the response to binary and pad with zeros to get to 12 digits e.g. 0000 0000 0001.&#xa;Refering to the far left digit as the first digit and the far right as the 12th digit:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;color:#a31515;&quot;&gt;&#xa;if the 11th digit=1 then &#39;triggered&#39;&#xa;if the 10th digit=1 then &#39;pending&#39;&#xa;if the 9th digit=1 then &#39;arming&#39;&#xa;if the 4th digit=1 then &#39;armed_away&#39;&#xa;if the 3rd digit=1 then &#39;armed_home&#39;&#xa;if the 2nd digit=1 then &#39;armed_night&#39;&#xa;if the 1st digit=1 then &#39;disarmed&#39;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;else ignore it and don&#39;t update MQTT&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillOpacity=100;fillColor=#ffeca9;strokeWidth=0;lucidId=wx.JTgYuVlC~;" vertex="1" parent="1">
          <mxGeometry x="263" y="3945" width="382" height="382" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-345" value="Watch for Monitor updates from Inception" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;fontStyle=1;align=left;spacing=3.8;verticalAlign=middle;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=JbsrMTGSsnx.;" vertex="1" parent="1">
          <mxGeometry x="-1260" y="6150" width="882" height="73" as="geometry" />
        </mxCell>
        <mxCell id="cTAOk4yeP9FnPeryfewb-346" value="The endpoint below allows long polling, which means it will hold the connection option until there&#39;s a state change. On state change, it will return a 200 with details in the response. You then need to call the endpoint again to continue another long poll. If it times out because there was no state change (200 response with no response body), start the polling again." style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;fontSize=26.7;fontColor=#333333;align=left;spacing=3.8;verticalAlign=middle;strokeOpacity=0;fillOpacity=0;rounded=1;absoluteArcSize=1;arcSize=9;fillColor=#ffffff;strokeWidth=2.3;lucidId=JbsryKsBL2cG;" vertex="1" parent="1">
          <mxGeometry x="-1260" y="6223" width="1110" height="135" as="geometry" />
        </mxCell>
