        <mxCell id="cTAOk4yeP9FnPeryfewb-286" value="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:25.7px;font-weight: bold;&quot;&gt;topic:&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt; &amp;lt;discovery_prefix&amp;gt;/switch/&amp;lt;name&amp;gt;/config&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;font-weight: bold;&quot;&gt;where:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:10.7px;&quot;&gt;- discovery_prefix = mqtt.discovery_prefix from config&#xa;- name = name from API response converted to lowercase/snake_case &lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;font-weight: bold;&quot;&gt;Example:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12.3px;&quot;&gt;homeassistant/switch/indoor_screamer/config&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" style="html=1;overflow=block;blockSpacing=1;whiteSpace=wrap;shadow=1;fontSize=13;spacing=3.8;strokeColor=none;fillColor=#FFECA9;strokeWidth=0;lucidId=l9uKS5211NtI;" vertex="1" parent="1">
