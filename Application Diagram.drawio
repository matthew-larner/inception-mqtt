        <UserObject label="&lt;div style=&quot;display: flex; justify-content: center; text-align: center; align-items: baseline; font-size: 0; line-height: 1.25;margin-top: -2px;&quot;&gt;&lt;span&gt;&lt;span style=&quot;font-size:14.9px;color:#000000;&quot;&gt;&lt;span style=&quot;font-size:14.9px;color:#000000;&quot;&gt;POST /control/area/%area_id%/activity&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:14.9px;color:#000000;font-weight: bold;&quot;&gt;Where:&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:14.9px;color:#000000;&quot;&gt;- {area_id} is from memory (from GET on startup for that area.)&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:14.9px;color:#000000;font-weight: bold;&quot;&gt;Payload:&lt;/span&gt;&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#000000;&quot;&gt;{&#xa;    &lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#a31515;&quot;&gt;&quot;Type&quot;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#000000;&quot;&gt;: &lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#0451a5;&quot;&gt;&quot;ControlArea&quot;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#000000;&quot;&gt;,&#xa;    &lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#a31515;&quot;&gt;&quot;AreaControlType&quot;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#000000;&quot;&gt;: {message}&#xa;&lt;/span&gt;&lt;span style=&quot;font-size:12px;color:#000000;&quot;&gt;}&#xa;(where {message} is from the raw MQTT message)&#xa;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" placeholders="1" id="cTAOk4yeP9FnPeryfewb-245">
